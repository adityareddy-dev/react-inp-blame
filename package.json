{
  "name": "react-inp-blame-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Interaction attribution for INP: joins Event Timing and Long Animation Frames to the React fiber tree",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/demo",
    "apps/demo-react*",
    "apps/next-demo"
  ],
  "scripts": {
    "build": "npm run build -w packages/core",
    "dev": "npm run dev -w apps/demo",
    "test": "npm run test -w apps/demo",
    "test:prod": "npm run test:prod -w apps/demo",
    "test:unit": "node --import ./packages/core/test/ts-imports.ts --test packages/core/test/*.test.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/demo/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "baseline-browser-mapping": "2.11.22"
  }
}
