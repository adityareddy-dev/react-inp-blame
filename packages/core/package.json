{
  "name": "react-inp-blame",
  "version": "0.0.1",
  "description": "Which React component made this interaction slow. Joins Event Timing + Long Animation Frames to the fiber tree, emits Chrome Performance panel tracks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./auto": { "types": "./dist/auto.d.ts", "import": "./dist/auto.js" },
    "./display-names-loader": { "types": "./display-names-loader.d.cts", "default": "./display-names-loader.cjs" }
  },
  "sideEffects": ["./dist/auto.js", "./src/auto.ts"],
  "files": ["dist", "display-names-loader.cjs", "display-names-loader.d.cts", "README.md"],
  "scripts": { "build": "tsc -p tsconfig.json" },
  "keywords": ["react", "inp", "web-vitals", "performance", "event-timing", "long-animation-frames", "devtools"],
  "devDependencies": { "typescript": "^5.6.0" }
}
