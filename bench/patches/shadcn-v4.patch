@@ -257,4 +261,22 @@ const nextConfig = {
 
 const withMDX = createMDX({})
 
-export default withMDX(nextConfig)
+// Benchmark only. BENCH_CONFIG picks the configuration under test:
+//   ""  A  the library is not applied at all, so nothing from it reaches the build
+//   "b" B  enabled, debugGlobal on so the harness can read stats()/reports()
+//   "c" C  as B plus the on-page overlay
+// withInpBlame goes outermost so it merges into whatever turbopack rules and
+// webpack hook the MDX wrapper already added.
+function withBench(config) {
+  const runtime = { debugGlobal: true }
+  switch (process.env.BENCH_CONFIG || "") {
+    case "b":
+      return withInpBlame(config, { enabled: true, runtime })
+    case "c":
+      return withInpBlame(config, { enabled: true, runtime: { ...runtime, overlay: true } })
+    default:
+      return config
+  }
+}
+
+export default withBench(withMDX(nextConfig))
